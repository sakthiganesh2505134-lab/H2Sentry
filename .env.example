# ==============================================================================
# H2SENTRY PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# SIH 2026 - Problem Statement SIH26118 (MRPL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (e.g., Render / Railway / Docker)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000

# PostgreSQL Database Connection String (e.g. Render PostgreSQL or Supabase)
# Leave empty in local development to automatically use SQLite fallback (data/h2sentry.db)
DATABASE_URL=postgresql://user:password@hostname:5432/h2sentry_db

# Cryptographic Secret for Stateless JWT Token Signing (Generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-secure-32-byte-hex-string-for-production

# Permitted CORS Origins (comma-separated list of deployed frontend URLs)
# In production, set to your Vercel/Render frontend domain(s)
ALLOWED_ORIGINS=https://h2sentry.vercel.app,https://your-custom-domain.com

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (e.g., Vercel / Netlify / Cloudflare Pages)
# ------------------------------------------------------------------------------
# Set this in your Vercel/Netlify Environment Variables dashboard to point to your deployed backend
# Example: https://h2sentry-backend.onrender.com
VITE_API_BASE_URL=https://your-backend-service.onrender.com

