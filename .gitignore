# ==============================================================================
# H2Sentry .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.crt
*.pfx
*.p12
localhost-key.pem
localhost.pem

# ------------------------------------------------------------------------------
# 2. Python Artifacts & Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Node / Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Binaries, Executables & Utilities
# ------------------------------------------------------------------------------
cloudflared.exe
*.exe
*.dll
*.dylib

# ------------------------------------------------------------------------------
# 5. Runtime Data & SQLite Databases
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.sqlite3
backend/data/*.db
backend/data/*.sqlite3
backend/data/*.db-journal
backend/data/*.db-wal
data/uploads/*
!data/uploads/.gitkeep
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 6. Temporary & Scratch Files
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. IDE & OS Metadata
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
